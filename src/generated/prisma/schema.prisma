generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id          String   @id @default(uuid())
  name        String
  cpfcnpj     String   @unique // Adicionado @unique
  email       String   @unique
  password    String
  userType    Int
  createDate  DateTime @default(now())
  sellings    Int
  rate        Float
  imgUrl      String
  contact     String
  contactType Int
  revenue     Float    @default(0)

  // Campos de Mapa
  farmName  String?
  latitude  Float?
  longitude Float?

  // Relacionamentos
  products               PRODUCT[]
  agendamentosCliente    AGENDAMENTO[] @relation("AgendamentosCliente")
  agendamentosAgricultor AGENDAMENTO[] @relation("AgendamentosAgricultor")

  // Novos relacionamentos adicionados
  harvests  HARVEST[]
  addresses ADDRESS[]
}

model HARVEST {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  description String
  harvestDate DateTime

  // Relacionamento configurado
  owner user @relation(fields: [ownerId], references: [id])
}

model ADDRESS {
  id     String @id @default(uuid())
  userId String
  cep    String
  city   String

  // Relacionamento configurado
  user user @relation(fields: [userId], references: [id])
}

model PRODUCT {
  id           String        @id @default(uuid())
  name         String
  price        Float
  imgUrl       String
  description  String?
  quantity     Int
  ownerId      String
  type         Int
  harvestDate  DateTime
  harvestType  Int
  productState Boolean
  harvest      String
  unityType    Int
  owner        user          @relation(fields: [ownerId], references: [id])
  agendamentos AGENDAMENTO[]
}

model AGENDAMENTO {
  id           String   @id @default(uuid())
  clientId     String
  farmerId     String
  productId    String
  quantity     Int
  totalPrice   Float
  status       Int
  scheduledFor DateTime
  createdAt    DateTime @default(now())

  client  user    @relation("AgendamentosCliente", fields: [clientId], references: [id])
  farmer  user    @relation("AgendamentosAgricultor", fields: [farmerId], references: [id])
  product PRODUCT @relation(fields: [productId], references: [id])
}

model CONVERSATION {
  id             String    @id @default(uuid())
  participantAId String
  participantBId String
  createdAt      DateTime  @default(now())
  messages       MESSAGE[]

  @@unique([participantAId, participantBId])
}

model MESSAGE {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   CONVERSATION @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
}
